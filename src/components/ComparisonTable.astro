---
interface Item {
  name: string;
  badge?: string;
  rating: string;
  bestFor: string;
  pricing: string;
  link: string;
  ctaText?: string;
}

interface Props {
  title?: string;
  items: Item[];
}

const { title = 'Independent Benchmark Comparison', items = [] } = Astro.props;
---

<div class="my-10 overflow-hidden rounded-3xl border border-slate-200/90 bg-white shadow-xs">
  {title && (
    <div class="bg-slate-50 px-6 py-4.5 border-b border-slate-200/80 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="text-sky-600 font-bold">📊</span>
        <h3 class="text-sm font-extrabold uppercase tracking-wider text-slate-900 m-0">{title}</h3>
      </div>
      <span class="text-[11px] text-slate-400 font-medium">Scroll horizontally →</span>
    </div>
  )}

  <div class="overflow-x-auto">
    <table class="w-full text-left border-collapse text-sm">
      <thead>
        <tr class="border-b border-slate-200/80 bg-slate-50/50 text-[11px] uppercase tracking-wider text-slate-500 font-bold">
          <th class="py-4 px-5">Platform / Tool</th>
          <th class="py-4 px-4">Score</th>
          <th class="py-4 px-5">Best For</th>
          <th class="py-4 px-4">Pricing</th>
          <th class="py-4 px-5 text-right">Verdict</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        {items.map((item, index) => (
          <tr class={index === 0 ? 'bg-sky-50/25 hover:bg-sky-50/40 transition-colors' : 'hover:bg-slate-50/70 transition-colors'}>
            <td class="py-4.5 px-5 font-bold text-slate-950">
              <div class="flex items-center gap-2.5">
                <span class="text-sm">{item.name}</span>
                {item.badge && (
                  <span class="text-[10px] uppercase font-black tracking-wider px-2.5 py-0.5 rounded-full bg-sky-100 text-sky-800 border border-sky-200 shrink-0">
                    {item.badge}
                  </span>
                )}
              </div>
            </td>
            <td class="py-4.5 px-4 font-bold text-slate-900 whitespace-nowrap">
              <span class="text-amber-500">★</span> {item.rating}
            </td>
            <td class="py-4.5 px-5 text-slate-600 text-xs leading-relaxed max-w-xs">
              {item.bestFor}
            </td>
            <td class="py-4.5 px-4 font-bold text-emerald-700 text-xs whitespace-nowrap">
              {item.pricing}
            </td>
            <td class="py-4.5 px-5 text-right whitespace-nowrap">
              <a
                href={item.link}
                target="_blank"
                rel="sponsored nofollow noopener"
                class="inline-block px-4 py-2 text-xs font-bold rounded-xl bg-slate-900 hover:bg-sky-600 text-white transition-all shadow-xs"
              >
                {item.ctaText || 'Check Deal'} →
              </a>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>
