---
// Reading Progress Bar Component
---

<div id="reading-progress-container" class="fixed top-0 left-0 w-full h-1 z-50 bg-transparent">
  <div id="reading-progress-bar" class="h-full bg-gradient-to-r from-sky-500 to-indigo-600 w-0 transition-all duration-75"></div>
</div>

<script>
  function updateProgress() {
    const article = document.querySelector('article');
    const progressBar = document.getElementById('reading-progress-bar');
    if (!article || !progressBar) return;

    const totalHeight = article.clientHeight;
    const windowHeight = window.innerHeight;
    const articleTop = article.offsetTop;
    const scrollY = window.scrollY;

    const scrollPercentage = Math.min(
      100,
      Math.max(0, ((scrollY - articleTop) / (totalHeight - windowHeight)) * 100)
    );

    progressBar.style.width = `${scrollPercentage}%`;
  }

  window.addEventListener('scroll', updateProgress, { passive: true });
  document.addEventListener('astro:page-load', updateProgress);
</script>
