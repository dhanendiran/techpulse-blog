---
import { getCollection, type CollectionEntry } from 'astro:content';

interface Props {
  currentPostId: string;
  category: string;
}

const { currentPostId, category } = Astro.props;

const allPosts = await getCollection('blog');
const related = allPosts
  .filter((p) => p.id !== currentPostId && p.data.category === category)
  .slice(0, 2);

// If not enough in same category, fill with other recent posts
if (related.length < 2) {
  const fillers = allPosts
    .filter((p) => p.id !== currentPostId && !related.some((r) => r.id === p.id))
    .slice(0, 2 - related.length);
  related.push(...fillers);
}
---

{related.length > 0 && (
  <section class="my-12 pt-8 border-t border-slate-200">
    <div class="flex items-center justify-between mb-6">
      <h3 class="text-xl font-extrabold text-slate-900 tracking-tight flex items-center gap-2 m-0">
        <span>📚</span> Recommended Next Reads
      </h3>
      <a href="/blog" class="text-xs font-semibold text-sky-600 hover:underline">
        All Articles →
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {related.map((post) => (
        <a
          href={`/blog/${post.id}`}
          class="p-5 rounded-2xl bg-white border border-slate-200 hover:border-sky-300 hover:shadow-md transition-all group flex flex-col justify-between no-underline"
        >
          <div>
            <div class="flex items-center gap-2 mb-2">
              <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-sky-50 text-sky-700">
                {post.data.category}
              </span>
              <span class="text-[11px] text-slate-400">{post.data.readingTime}</span>
            </div>
            <h4 class="text-base font-bold text-slate-900 group-hover:text-sky-600 transition-colors line-clamp-2 m-0 mb-2">
              {post.data.title}
            </h4>
            <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed m-0">
              {post.data.description}
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-400">
            <span>By {post.data.author}</span>
            <span class="font-semibold text-sky-600 group-hover:translate-x-0.5 transition-transform inline-flex items-center gap-1">
              Read →
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>
)}
