---
interface Props {
  title?: string;
  subtitle?: string;
  className?: string;
}

const {
  title = 'Stay Ahead of the Tech & AI Curve',
  subtitle = 'Get our weekly curated breakdown of top AI engineering frameworks, software architecture blueprints, and high-ROI dev tools. Zero spam, unsubscribe anytime.',
  className = '',
} = Astro.props;
---

<section id="newsletter" class={`my-12 rounded-3xl bg-gradient-to-br from-slate-900 via-slate-800 to-indigo-950 text-white p-8 sm:p-10 shadow-xl relative overflow-hidden ${className}`}>
  <!-- Decorative Background Glow -->
  <div class="absolute -top-24 -right-24 w-72 h-72 bg-sky-500/20 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-24 -left-24 w-72 h-72 bg-indigo-500/20 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative z-10 max-w-2xl mx-auto text-center">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-white/10 text-sky-300 border border-white/15 mb-4">
      <span>✉️</span> Weekly AI & Engineering Digest
    </div>

    <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white mb-3">
      {title}
    </h2>

    <p class="text-sm sm:text-base text-slate-300 mb-8 leading-relaxed">
      {subtitle}
    </p>

    <!-- Email Subscription Form -->
    <form
      action="https://buttondown.email/api/emails/embed-subscribe/techpulse"
      method="post"
      target="popupwindow"
      onsubmit="window.open('https://buttondown.email/api/emails/embed-subscribe/techpulse', 'popupwindow')"
      class="flex flex-col sm:flex-row items-center gap-3 max-w-md mx-auto"
    >
      <input
        type="email"
        name="email"
        required
        placeholder="Enter your work or personal email..."
        class="w-full px-4 py-3 rounded-xl bg-white/10 border border-white/20 text-white placeholder-slate-400 text-sm focus:outline-none focus:ring-2 focus:ring-sky-400 focus:bg-white/15 transition-all"
      />
      <button
        type="submit"
        class="w-full sm:w-auto shrink-0 px-6 py-3 rounded-xl bg-sky-500 hover:bg-sky-400 active:bg-sky-600 text-slate-950 font-bold text-sm shadow-md hover:shadow-sky-500/25 transition-all cursor-pointer"
      >
        Join Free
      </button>
    </form>

    <div class="mt-4 flex items-center justify-center gap-6 text-[11px] text-slate-400">
      <span class="flex items-center gap-1">
        <svg class="w-3.5 h-3.5 text-emerald-400" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
        </svg>
        100% Free
      </span>
      <span class="flex items-center gap-1">
        <svg class="w-3.5 h-3.5 text-emerald-400" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
        </svg>
        No spam, ever
      </span>
      <span class="flex items-center gap-1">
        <svg class="w-3.5 h-3.5 text-emerald-400" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
        </svg>
        One-click unsubscribe
      </span>
    </div>
  </div>
</section>
