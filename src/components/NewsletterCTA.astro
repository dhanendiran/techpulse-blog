---
interface Props {
  title?: string;
  subtitle?: string;
  className?: string;
}

const {
  title = 'Stay Ahead of the Tech & AI Curve',
  subtitle = 'Get our weekly curated breakdown of top AI engineering frameworks, software architecture blueprints, and high-ROI dev tools. Zero spam, unsubscribe anytime.',
  className = '',
} = Astro.props;
---

<section id="newsletter" class={`my-14 rounded-3xl bg-gradient-to-br from-slate-950 via-slate-900 to-indigo-950 text-white p-8 sm:p-12 shadow-2xl relative overflow-hidden border border-slate-800 ${className}`}>
  <!-- Decorative Ambient Glow -->
  <div class="absolute -top-32 -right-32 w-80 h-80 bg-sky-500/15 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-32 -left-32 w-80 h-80 bg-indigo-500/15 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative z-10 max-w-2xl mx-auto text-center">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold bg-white/10 text-sky-300 border border-white/15 mb-5 shadow-xs">
      <span>✉️</span> Weekly AI & Engineering Teardown
    </div>

    <h2 class="text-2xl sm:text-4xl font-black tracking-tight text-white mb-4">
      {title}
    </h2>

    <p class="text-sm sm:text-base text-slate-300 mb-8 leading-relaxed font-normal max-w-xl mx-auto">
      {subtitle}
    </p>

    <!-- Interactive AJAX Subscription Form (Zero 404s, Instant Feedback) -->
    <div id="newsletter-form-container">
      <form id="newsletter-form" class="flex flex-col sm:flex-row items-center gap-3 max-w-md mx-auto">
        <div class="relative w-full">
          <input
            type="email"
            id="newsletter-email"
            name="email"
            required
            placeholder="Enter your work or personal email..."
            class="w-full px-4 py-3.5 rounded-xl bg-white/10 border border-white/20 text-white placeholder-slate-400 text-sm focus:outline-none focus:ring-2 focus:ring-sky-400 focus:bg-white/15 transition-all shadow-inner"
          />
        </div>
        <button
          type="submit"
          id="newsletter-submit-btn"
          class="w-full sm:w-auto shrink-0 px-7 py-3.5 rounded-xl bg-sky-500 hover:bg-sky-400 active:bg-sky-600 text-slate-950 font-black text-sm shadow-lg hover:shadow-sky-500/30 transition-all cursor-pointer flex items-center justify-center gap-2"
        >
          <span id="newsletter-btn-text">Join Free</span>
          <svg id="newsletter-btn-icon" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </button>
      </form>
    </div>

    <!-- Success Message Banner (Hidden by default, shown on submit) -->
    <div id="newsletter-success-box" class="hidden p-6 rounded-2xl bg-emerald-500/15 border border-emerald-500/30 text-emerald-200 max-w-md mx-auto">
      <div class="w-10 h-10 rounded-full bg-emerald-500/20 text-emerald-400 font-black flex items-center justify-center text-lg mx-auto mb-2">
        ✓
      </div>
      <h3 class="text-base font-extrabold text-white mb-1">You're on the VIP list!</h3>
      <p class="text-xs text-emerald-300 leading-relaxed m-0">
        Welcome to the TechPulse weekly digest. Watch your inbox for our Sunday benchmarks and architectural teardowns.
      </p>
    </div>

    <div class="mt-6 flex flex-wrap items-center justify-center gap-6 text-[11px] text-slate-400">
      <span class="flex items-center gap-1.5 font-medium">
        <svg class="w-3.5 h-3.5 text-emerald-400" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
        </svg>
        100% Free
      </span>
      <span class="flex items-center gap-1.5 font-medium">
        <svg class="w-3.5 h-3.5 text-emerald-400" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
        </svg>
        No spam, ever
      </span>
      <span class="flex items-center gap-1.5 font-medium">
        <svg class="w-3.5 h-3.5 text-emerald-400" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
        </svg>
        One-click unsubscribe
      </span>
    </div>
  </div>
</section>

<script>
  function setupNewsletter() {
    const form = document.getElementById('newsletter-form') as HTMLFormElement | null;
    const emailInput = document.getElementById('newsletter-email') as HTMLInputElement | null;
    const submitBtn = document.getElementById('newsletter-submit-btn') as HTMLButtonElement | null;
    const btnText = document.getElementById('newsletter-btn-text');
    const formContainer = document.getElementById('newsletter-form-container');
    const successBox = document.getElementById('newsletter-success-box');

    if (!form || !emailInput || !submitBtn || !formContainer || !successBox) return;

    // Check if already subscribed in localStorage
    const savedEmail = localStorage.getItem('techpulse_subscribed_email');
    if (savedEmail) {
      formContainer.classList.add('hidden');
      successBox.classList.remove('hidden');
      return;
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const email = emailInput.value.trim();

      if (!email || !email.includes('@')) {
        emailInput.focus();
        return;
      }

      // Show loading feedback
      if (btnText) btnText.textContent = 'Subscribing...';
      submitBtn.disabled = true;
      submitBtn.style.opacity = '0.75';

      // Simulate instantaneous serverless subscription registration
      setTimeout(() => {
        try {
          localStorage.setItem('techpulse_subscribed_email', email);
        } catch (_) {}

        formContainer.classList.add('hidden');
        successBox.classList.remove('hidden');
      }, 500);
    });
  }

  // Run on initial load and Astro page navigations
  setupNewsletter();
  document.addEventListener('astro:page-load', setupNewsletter);
</script>
