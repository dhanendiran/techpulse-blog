---
interface Props {
  title: string;
  badge?: string;
  rating?: string;
  price?: string;
  description: string;
  pros?: string[];
  cons?: string[];
  affiliateUrl: string;
  ctaText?: string;
  tagline?: string;
  specs?: { label: string; value: string }[];
}

const {
  title,
  badge = "Editor's Choice",
  rating = '4.9/5',
  price = 'Starts Free / $20 mo',
  description,
  pros = [],
  cons = [],
  affiliateUrl,
  ctaText = 'Check Current Deal & Pricing',
  tagline = 'Best for AI Developers & Teams',
  specs = [],
} = Astro.props;
---

<div class="my-10 rounded-3xl border border-slate-200/90 bg-white p-6 sm:p-8 shadow-sm hover:shadow-md transition-all relative overflow-hidden">
  <!-- Top Banner Accent -->
  <div class="flex flex-wrap items-center justify-between gap-3 mb-6 pb-4 border-b border-slate-100">
    <div class="flex items-center gap-2">
      {badge && (
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-slate-900 text-white shadow-xs">
          <span>★</span> {badge}
        </span>
      )}
      <span class="text-xs font-bold text-sky-700 bg-sky-50 px-2.5 py-1 rounded-full border border-sky-100">
        Lab Verified 2026
      </span>
    </div>

    <div class="flex items-center gap-4 text-xs">
      <div>
        <span class="text-slate-400 font-medium">Editorial Score:</span>
        <strong class="text-slate-900 font-extrabold text-sm ml-1 text-amber-600">★ {rating}</strong>
      </div>
      <div class="h-3 w-px bg-slate-200"></div>
      <div>
        <span class="text-slate-400 font-medium">Pricing:</span>
        <strong class="text-emerald-700 font-bold text-sm ml-1">{price}</strong>
      </div>
    </div>
  </div>

  <!-- Product Title & Tagline -->
  <div class="mb-4">
    <h3 class="text-2xl sm:text-3xl font-extrabold text-slate-950 tracking-tight m-0">{title}</h3>
    <p class="text-sm font-semibold text-sky-600 mt-1 mb-0">{tagline}</p>
  </div>

  <p class="text-slate-600 text-base leading-relaxed mb-6 font-normal">
    {description}
  </p>

  <!-- Specs Grid if provided -->
  {specs.length > 0 && (
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6 p-4 rounded-2xl bg-slate-50 border border-slate-100 text-xs">
      {specs.map((s) => (
        <div>
          <span class="text-slate-400 block mb-0.5">{s.label}</span>
          <strong class="text-slate-800 font-semibold">{s.value}</strong>
        </div>
      ))}
    </div>
  )}

  <!-- Pros & Cons Grid (High Contrast Psychology) -->
  {(pros.length > 0 || cons.length > 0) && (
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
      {pros.length > 0 && (
        <div class="bg-emerald-50/50 p-4 rounded-2xl border border-emerald-100/80">
          <h4 class="text-xs font-extrabold uppercase tracking-wider text-emerald-900 flex items-center gap-1.5 mb-2.5 m-0">
            <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
            </svg>
            Key Strengths
          </h4>
          <ul class="text-xs space-y-1.5 text-slate-700 pl-0 list-none m-0">
            {pros.map((pro) => (
              <li class="flex items-start gap-2">
                <span class="text-emerald-600 font-bold shrink-0 mt-0.5">✓</span>
                <span class="leading-relaxed">{pro}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      {cons.length > 0 && (
        <div class="bg-rose-50/50 p-4 rounded-2xl border border-rose-100/80">
          <h4 class="text-xs font-extrabold uppercase tracking-wider text-rose-900 flex items-center gap-1.5 mb-2.5 m-0">
            <svg class="w-4 h-4 text-rose-600" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
            </svg>
            Drawbacks & Caveats
          </h4>
          <ul class="text-xs space-y-1.5 text-slate-700 pl-0 list-none m-0">
            {cons.map((con) => (
              <li class="flex items-start gap-2">
                <span class="text-rose-500 font-bold shrink-0 mt-0.5">✗</span>
                <span class="leading-relaxed">{con}</span>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  )}

  <!-- CTA Conversion Bar -->
  <div class="pt-4 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-4">
    <div class="text-[11px] text-slate-400 flex items-center gap-1.5">
      <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
      <span>Tested in lab • Independent recommendation</span>
    </div>
    <a
      href={affiliateUrl}
      target="_blank"
      rel="sponsored nofollow noopener"
      class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-xl bg-sky-600 hover:bg-sky-700 active:bg-sky-800 text-white font-bold text-sm shadow-sm hover:shadow-md transition-all group"
    >
      <span>{ctaText}</span>
      <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
      </svg>
    </a>
  </div>
</div>
