---
interface Props {
  title: string;
  badge?: string;
  rating?: string;
  price?: string;
  description: string;
  pros?: string[];
  cons?: string[];
  affiliateUrl: string;
  ctaText?: string;
  tagline?: string;
}

const {
  title,
  badge = "Editor's Choice",
  rating = '4.9/5',
  price = 'Starts Free / $20 mo',
  description,
  pros = [],
  cons = [],
  affiliateUrl,
  ctaText = 'Check Current Deal & Pricing',
  tagline = 'Best for AI Developers & Teams',
} = Astro.props;
---

<div class="my-8 rounded-2xl border-2 border-sky-500/30 bg-gradient-to-b from-sky-50/40 via-white to-white p-6 shadow-sm hover:shadow-md transition-shadow relative overflow-hidden">
  <!-- Badge -->
  {badge && (
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-sky-600 text-white shadow-sm mb-4">
      <span>★</span> {badge}
    </div>
  )}

  <div class="flex flex-col md:flex-row md:items-start justify-between gap-4 mb-4">
    <div>
      <h3 class="text-2xl font-bold text-slate-900 m-0">{title}</h3>
      <p class="text-sm font-medium text-sky-700 mt-1 mb-0">{tagline}</p>
    </div>

    <div class="flex items-center gap-3">
      <div class="text-right">
        <div class="text-xs text-slate-500 font-medium">Overall Score</div>
        <div class="text-xl font-extrabold text-slate-900 flex items-center gap-1">
          <span class="text-amber-500">★</span> {rating}
        </div>
      </div>
      <div class="text-right pl-3 border-l border-slate-200">
        <div class="text-xs text-slate-500 font-medium">Pricing</div>
        <div class="text-sm font-bold text-emerald-600">{price}</div>
      </div>
    </div>
  </div>

  <p class="text-slate-600 text-sm leading-relaxed mb-6">
    {description}
  </p>

  <!-- Pros & Cons Grid -->
  {(pros.length > 0 || cons.length > 0) && (
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6 pt-4 border-t border-slate-100">
      {pros.length > 0 && (
        <div class="bg-emerald-50/60 p-3.5 rounded-xl border border-emerald-100">
          <h4 class="text-xs font-bold uppercase tracking-wider text-emerald-800 flex items-center gap-1.5 mb-2 m-0">
            <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
            </svg>
            What We Like
          </h4>
          <ul class="text-xs space-y-1 text-slate-700 pl-0 list-none m-0">
            {pros.map((pro) => (
              <li class="flex items-start gap-1.5">
                <span class="text-emerald-500 font-bold shrink-0">✓</span>
                <span>{pro}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      {cons.length > 0 && (
        <div class="bg-rose-50/60 p-3.5 rounded-xl border border-rose-100">
          <h4 class="text-xs font-bold uppercase tracking-wider text-rose-800 flex items-center gap-1.5 mb-2 m-0">
            <svg class="w-4 h-4 text-rose-600" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
            </svg>
            Room for Improvement
          </h4>
          <ul class="text-xs space-y-1 text-slate-700 pl-0 list-none m-0">
            {cons.map((con) => (
              <li class="flex items-start gap-1.5">
                <span class="text-rose-500 font-bold shrink-0">✗</span>
                <span>{con}</span>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  )}

  <!-- CTA Button (FTC & SEO compliant with rel="sponsored nofollow noopener") -->
  <div class="pt-2 flex flex-col sm:flex-row items-center justify-between gap-3">
    <div class="text-[11px] text-slate-400">
      Verified benchmark • Affiliate partner link
    </div>
    <a
      href={affiliateUrl}
      target="_blank"
      rel="sponsored nofollow noopener"
      class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-sky-600 hover:bg-sky-700 active:bg-sky-800 text-white font-semibold text-sm shadow-sm hover:shadow transition-all group"
    >
      <span>{ctaText}</span>
      <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
      </svg>
    </a>
  </div>
</div>
