---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings = [] } = Astro.props;
const filteredHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{filteredHeadings.length > 0 && (
  <nav class="my-8 p-5 bg-white border border-slate-200 rounded-2xl shadow-xs">
    <div class="flex items-center gap-2 text-sm font-bold text-slate-900 mb-3">
      <span>📑</span> Table of Contents
    </div>
    <ul class="space-y-1.5 text-xs text-slate-600 pl-0 list-none m-0">
      {filteredHeadings.map((h) => (
        <li class={h.depth === 3 ? 'pl-4 text-slate-500' : 'font-medium text-slate-700'}>
          <a
            href={`#${h.slug}`}
            class="hover:text-sky-600 transition-colors inline-block py-0.5"
          >
            {h.depth === 3 ? '↳ ' : '• '} {h.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
