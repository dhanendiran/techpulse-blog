---
interface Props {
  title: string;
  description: string;
  image?: string;
  article?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  category?: string;
}

const {
  title,
  description,
  image = '/images/og-default.svg',
  article = false,
  publishedTime,
  modifiedTime,
  author = 'Dhanendiran M',
  category,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://techpulse.dev');
const imageURL = new URL(image, Astro.site || 'https://techpulse.dev');

const siteTitle = 'TechPulse | AI, Software & Engineering Insights';
const fullTitle = title === siteTitle ? title : `${title} | TechPulse`;

// JSON-LD Schema Generation for Google E-E-A-T & Rich Snippets
const schema = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description: description,
      image: [imageURL.href],
      datePublished: publishedTime,
      dateModified: modifiedTime || publishedTime,
      author: {
        '@type': 'Person',
        name: author,
        url: new URL('/about', Astro.site || 'https://techpulse.dev').href,
      },
      publisher: {
        '@type': 'Organization',
        name: 'TechPulse',
        url: Astro.site?.toString() || 'https://techpulse.dev',
        logo: {
          '@type': 'ImageObject',
          url: new URL('/images/logo.svg', Astro.site || 'https://techpulse.dev').href,
        },
      },
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': canonicalURL.href,
      },
      articleSection: category || 'Technology',
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'TechPulse',
      url: Astro.site?.toString() || 'https://techpulse.dev',
      description: description,
      publisher: {
        '@type': 'Organization',
        name: 'TechPulse',
      },
    };
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={description} />
<meta name="author" content={author} />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:site_name" content="TechPulse" />
{article && publishedTime && <meta property="article:published_time" content={publishedTime} />}
{article && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
{article && category && <meta property="article:section" content={category} />}

<!-- Twitter Card -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={fullTitle} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={imageURL} />

<!-- RSS Feed Auto-discovery -->
<link rel="alternate" type="application/rss+xml" title="TechPulse RSS Feed" href="/rss.xml" />

<!-- JSON-LD Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
