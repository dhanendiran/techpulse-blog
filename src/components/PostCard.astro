---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, category, readingTime, hasAffiliateLinks } = post.data;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
}).format(pubDate);
---

<article class="bg-white rounded-2xl border border-slate-200 hover:border-sky-300 hover:shadow-lg transition-all duration-200 flex flex-col overflow-hidden group">
  <div class="p-6 flex-1 flex flex-col justify-between">
    <div>
      <div class="flex items-center justify-between gap-2 mb-3">
        <span class="inline-block text-xs font-semibold px-2.5 py-1 rounded-md bg-sky-50 text-sky-700 border border-sky-100">
          {category}
        </span>
        <div class="flex items-center gap-2 text-xs text-slate-400">
          {hasAffiliateLinks && (
            <span class="text-[10px] uppercase font-bold text-amber-600 bg-amber-50 px-1.5 py-0.5 rounded border border-amber-200">
              Affiliate Review
            </span>
          )}
          <span>{readingTime}</span>
        </div>
      </div>

      <h3 class="text-xl font-bold text-slate-900 group-hover:text-sky-600 transition-colors line-clamp-2 mb-2">
        <a href={`/blog/${post.id}`}>
          {title}
        </a>
      </h3>

      <p class="text-sm text-slate-600 line-clamp-3 mb-4 leading-relaxed">
        {description}
      </p>
    </div>

    <div class="pt-4 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
      <div class="flex items-center gap-2">
        <div class="w-6 h-6 rounded-full bg-slate-900 text-white flex items-center justify-center font-bold text-[10px]">
          D
        </div>
        <span>{post.data.author}</span>
      </div>
      <time datetime={pubDate.toISOString()}>{formattedDate}</time>
    </div>
  </div>
</article>
