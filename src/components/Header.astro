---
const currentPath = Astro.url.pathname;

const navLinks = [
  { name: 'Articles', href: '/blog' },
  { name: 'Deals & Credits', href: '/deals' },
  { name: 'About', href: '/about' },
  { name: 'Contact', href: '/contact' },
];
---

<header class="sticky top-0 z-50 glass-header">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Logo & Brand -->
    <a href="/" class="flex items-center gap-2.5 group">
      <div class="w-9 h-9 rounded-xl bg-slate-900 flex items-center justify-center text-white font-black text-lg shadow-sm group-hover:bg-sky-600 transition-colors">
        ⚡
      </div>
      <div class="flex items-baseline gap-1.5">
        <span class="font-black text-xl tracking-tight text-slate-950">
          Tech<span class="text-sky-600">Pulse</span>
        </span>
        <span class="text-[9px] uppercase font-black tracking-widest px-1.5 py-0.5 rounded bg-slate-100 text-slate-700 border border-slate-200">
          LAB
        </span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-8">
      {navLinks.map((link) => {
        const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href) && !link.href.includes('?'));
        return (
          <a
            href={link.href}
            class={`text-sm font-bold transition-colors ${
              isActive ? 'text-sky-600' : 'text-slate-700 hover:text-slate-950'
            }`}
          >
            {link.name}
          </a>
        );
      })}
    </nav>

    <!-- Header Actions (Desktop & Mobile) -->
    <div class="flex items-center gap-2 sm:gap-3">
      <a
        href="/blog"
        title="Search Articles"
        class="p-2 text-slate-600 hover:text-slate-950 hover:bg-slate-100 rounded-xl transition-colors"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <circle cx="11" cy="11" r="8"/>
          <path d="m21 21-4.3-4.3"/>
        </svg>
      </a>

      <a
        href="/rss.xml"
        title="RSS Feed"
        class="hidden sm:inline-flex p-2 text-slate-600 hover:text-amber-600 hover:bg-slate-100 rounded-xl transition-colors"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z"/>
        </svg>
      </a>

      <a
        href="#newsletter"
        id="header-subscribe-btn"
        class="hidden sm:inline-flex items-center justify-center px-4 py-2 text-xs font-black text-white bg-slate-950 rounded-xl hover:bg-emerald-600 transition-colors shadow-xs"
      >
        Subscribe Free
      </a>

      <!-- Mobile Hamburger Menu Button -->
      <button
        id="mobile-menu-toggle"
        type="button"
        aria-label="Toggle Navigation Menu"
        class="md:hidden p-2 text-slate-700 hover:text-slate-950 hover:bg-slate-100 rounded-xl transition-colors"
      >
        <svg id="hamburger-icon" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
        <svg id="close-icon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div id="mobile-menu-drawer" class="hidden md:hidden border-b border-slate-200/80 bg-white/95 backdrop-blur-xl px-4 pt-3 pb-6 shadow-xl transition-all">
    <nav class="flex flex-col space-y-3">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="mobile-nav-link text-base font-bold text-slate-800 hover:text-sky-600 py-2 px-3 rounded-lg hover:bg-slate-50 transition-colors flex items-center justify-between"
        >
          <span>{link.name}</span>
          <span class="text-xs text-slate-400">→</span>
        </a>
      ))}
      <div class="pt-3 border-t border-slate-100 flex flex-col gap-2.5">
        <a
          href="#newsletter"
          id="mobile-subscribe-btn"
          class="w-full py-3 text-center text-xs font-black text-white bg-slate-950 rounded-xl hover:bg-emerald-600 transition-colors shadow-xs"
        >
          Subscribe to Newsletter Free
        </a>
        <div class="flex items-center justify-center gap-4 text-xs font-medium text-slate-500 pt-2">
          <a href="/about" class="hover:text-slate-900">Lab Standards</a>
          <span>•</span>
          <a href="/contact" class="hover:text-slate-900">Editorial Desk</a>
          <span>•</span>
          <a href="/rss.xml" class="hover:text-slate-900">RSS</a>
        </div>
      </div>
    </nav>
  </div>
</header>

<script>
  function setupHeaderInteractions() {
    // 1. Mobile Menu Toggle
    const menuBtn = document.getElementById('mobile-menu-toggle');
    const drawer = document.getElementById('mobile-menu-drawer');
    const hamburgerIcon = document.getElementById('hamburger-icon');
    const closeIcon = document.getElementById('close-icon');

    if (menuBtn && drawer && hamburgerIcon && closeIcon) {
      menuBtn.onclick = () => {
        const isOpen = !drawer.classList.contains('hidden');
        if (isOpen) {
          drawer.classList.add('hidden');
          hamburgerIcon.classList.remove('hidden');
          closeIcon.classList.add('hidden');
        } else {
          drawer.classList.remove('hidden');
          hamburgerIcon.classList.add('hidden');
          closeIcon.classList.remove('hidden');
        }
      };

      // Auto close drawer when clicking a mobile nav link
      const mobileLinks = drawer.querySelectorAll('a');
      mobileLinks.forEach((link) => {
        link.onclick = () => {
          drawer.classList.add('hidden');
          hamburgerIcon.classList.remove('hidden');
          closeIcon.classList.add('hidden');
        };
      });
    }

    // 2. Smooth Scroll to Newsletter Input
    const triggerSubscribe = (e: MouseEvent) => {
      const target = document.getElementById('newsletter');
      const input = document.getElementById('newsletter-email') as HTMLInputElement | null;
      if (target) {
        e.preventDefault();
        target.scrollIntoView({ behavior: 'smooth', block: 'center' });
        setTimeout(() => {
          if (input) {
            input.focus();
            input.classList.add('ring-4', 'ring-sky-400');
            setTimeout(() => input.classList.remove('ring-4', 'ring-sky-400'), 1500);
          }
        }, 500);
      }
    };

    const deskSubBtn = document.getElementById('header-subscribe-btn');
    const mobSubBtn = document.getElementById('mobile-subscribe-btn');
    if (deskSubBtn) deskSubBtn.onclick = triggerSubscribe;
    if (mobSubBtn) mobSubBtn.onclick = triggerSubscribe;
  }

  setupHeaderInteractions();
  document.addEventListener('astro:page-load', setupHeaderInteractions);
</script>
