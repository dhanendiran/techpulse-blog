---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import AdBanner from '../components/AdBanner.astro';
import NewsletterCTA from '../components/NewsletterCTA.astro';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featuredPost = sortedPosts.find((p) => p.data.featured) || sortedPosts[0];
const recentPosts = sortedPosts.filter((p) => p.id !== featuredPost?.id);

const featuredDate = featuredPost
  ? new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric' }).format(featuredPost.data.pubDate)
  : '';
---

<BaseLayout
  title="TechPulse - Engineering Benchmarks, AI Agents & Software Reviews"
  description="In-depth benchmarks, autonomous AI tool comparisons, and guides for developers looking to build scalable software and maximize productivity."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Hero Section -->
    <section class="text-center py-8 sm:py-12 border-b border-slate-200">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-sky-50 text-sky-700 border border-sky-200 mb-6">
        <span class="w-2 h-2 rounded-full bg-sky-500 animate-pulse"></span>
        Zero Fluff • Real Benchmarks • Verified ROI
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-slate-900 tracking-tight leading-tight max-w-4xl mx-auto mb-6">
        Autonomous AI, Cloud Systems & <span class="text-transparent bg-clip-text bg-gradient-to-r from-sky-600 to-indigo-600">Dev Tooling</span>
      </h1>

      <p class="text-lg sm:text-xl text-slate-600 max-w-2xl mx-auto mb-8 leading-relaxed">
        Technical teardowns, hands-on software reviews, and architectural blueprints designed to help engineers build faster and monetize their craft.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-3">
        <a
          href="/blog"
          class="px-6 py-3 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-semibold text-sm shadow-sm transition-all"
        >
          Explore All Articles →
        </a>
        <a
          href="#newsletter"
          class="px-6 py-3 rounded-xl bg-white hover:bg-slate-100 text-slate-700 font-semibold text-sm border border-slate-300 shadow-sm transition-all"
        >
          Join 15,000+ Readers
        </a>
      </div>
    </section>

    <!-- Top Homepage Display Ad (Leaderboard) -->
    <AdBanner slot="home-top-banner" label="Sponsored Placement" />

    <!-- Featured Post Hero Card -->
    {featuredPost && (
      <section class="my-12">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-2xl font-extrabold text-slate-900 tracking-tight flex items-center gap-2">
            <span>🔥</span> Featured Editorial
          </h2>
          <span class="text-xs uppercase font-bold tracking-wider text-sky-600">Must Read</span>
        </div>

        <div class="bg-gradient-to-br from-white to-slate-50 border border-slate-200 rounded-3xl p-6 sm:p-10 shadow-sm hover:shadow-md transition-shadow">
          <div class="flex flex-col lg:flex-row gap-8 items-start">
            <div class="flex-1">
              <div class="flex items-center gap-3 mb-4">
                <span class="text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full bg-sky-100 text-sky-800">
                  {featuredPost.data.category}
                </span>
                <span class="text-xs text-slate-500 font-medium">
                  {featuredPost.data.readingTime}
                </span>
                {featuredPost.data.hasAffiliateLinks && (
                  <span class="text-[10px] uppercase font-bold text-amber-600 bg-amber-50 px-2 py-0.5 rounded border border-amber-200">
                    Buyer's Guide
                  </span>
                )}
              </div>

              <h3 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mb-4 leading-snug">
                <a href={`/blog/${featuredPost.id}`} class="hover:text-sky-600 transition-colors">
                  {featuredPost.data.title}
                </a>
              </h3>

              <p class="text-slate-600 leading-relaxed text-base mb-6">
                {featuredPost.data.description}
              </p>

              <div class="flex items-center justify-between pt-4 border-t border-slate-200">
                <div class="flex items-center gap-2 text-xs text-slate-600">
                  <div class="w-7 h-7 rounded-full bg-slate-900 text-white flex items-center justify-center font-bold text-xs">
                    D
                  </div>
                  <div>
                    <span class="font-bold text-slate-900">{featuredPost.data.author}</span>
                    <span class="mx-1">•</span>
                    <span>{featuredDate}</span>
                  </div>
                </div>

                <a
                  href={`/blog/${featuredPost.id}`}
                  class="inline-flex items-center gap-1.5 text-sm font-bold text-sky-600 hover:text-sky-700"
                >
                  Read Full Teardown →
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- Recent Articles Grid -->
    <section class="my-16">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h2 class="text-2xl font-extrabold text-slate-900 tracking-tight">
            Latest Publications
          </h2>
          <p class="text-sm text-slate-500 mt-1">
            Deep-dive tutorials, benchmarks, and infrastructure analyses.
          </p>
        </div>

        <a href="/blog" class="text-sm font-semibold text-sky-600 hover:text-sky-700">
          View Archive ({allPosts.length}) →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {recentPosts.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    </section>

    <!-- Monetization Highlight: Recommended Developer Stack (Affiliate Widget) -->
    <section class="my-16 p-8 bg-white border border-slate-200 rounded-3xl shadow-sm">
      <div class="text-center max-w-xl mx-auto mb-8">
        <span class="text-xs font-bold uppercase tracking-wider text-sky-600 bg-sky-50 px-3 py-1 rounded-full border border-sky-100">
          Vetted Stack
        </span>
        <h3 class="text-2xl font-extrabold text-slate-900 mt-3 mb-2">
          Recommended Developer Tools
        </h3>
        <p class="text-sm text-slate-500">
          Software and services our engineers use daily to build production applications.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="p-4 rounded-xl border border-slate-100 bg-slate-50/50 hover:bg-white hover:border-sky-200 transition-all flex flex-col justify-between">
          <div>
            <div class="font-bold text-slate-900 mb-1">Cursor AI IDE</div>
            <p class="text-xs text-slate-500 mb-3">The premier AI-native editor for multi-file codebase edits.</p>
          </div>
          <a
            href="https://cursor.com?ref=techpulse"
            target="_blank"
            rel="sponsored nofollow noopener"
            class="text-xs font-bold text-sky-600 hover:underline"
          >
            Try Free Trial →
          </a>
        </div>

        <div class="p-4 rounded-xl border border-slate-100 bg-slate-50/50 hover:bg-white hover:border-sky-200 transition-all flex flex-col justify-between">
          <div>
            <div class="font-bold text-slate-900 mb-1">Hetzner Cloud</div>
            <p class="text-xs text-slate-500 mb-3">Ultra-cheap European & US VPS nodes with raw compute performance.</p>
          </div>
          <a
            href="https://hetzner.com?ref=techpulse"
            target="_blank"
            rel="sponsored nofollow noopener"
            class="text-xs font-bold text-sky-600 hover:underline"
          >
            Get €20 Credits →
          </a>
        </div>

        <div class="p-4 rounded-xl border border-slate-100 bg-slate-50/50 hover:bg-white hover:border-sky-200 transition-all flex flex-col justify-between">
          <div>
            <div class="font-bold text-slate-900 mb-1">Cloudflare Pages</div>
            <p class="text-xs text-slate-500 mb-3">Instant static edge hosting with zero bandwidth fees.</p>
          </div>
          <a
            href="https://cloudflare.com?ref=techpulse"
            target="_blank"
            rel="sponsored nofollow noopener"
            class="text-xs font-bold text-sky-600 hover:underline"
          >
            Deploy For Free →
          </a>
        </div>
      </div>
    </section>

    <!-- Email Newsletter Lead Magnet -->
    <NewsletterCTA />
  </div>
</BaseLayout>
