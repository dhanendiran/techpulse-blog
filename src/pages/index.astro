---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import AdBanner from '../components/AdBanner.astro';
import NewsletterCTA from '../components/NewsletterCTA.astro';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featuredPost = sortedPosts.find((p) => p.data.featured) || sortedPosts[0];
const recentPosts = sortedPosts.filter((p) => p.id !== featuredPost?.id);

const featuredDate = featuredPost
  ? new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric' }).format(featuredPost.data.pubDate)
  : '';
---

<BaseLayout
  title="TechPulse — Unbiased AI & Software Engineering Benchmarks"
  description="Reproducible software benchmarks, autonomous AI tool comparisons, and system design teardowns for engineering leaders and developers."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Hero Editorial Banner -->
    <section class="text-center py-10 sm:py-16 border-b border-slate-200/80">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold bg-white text-slate-900 border border-slate-200/80 shadow-xs mb-6">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>Independent Lab Tests &amp; Architecture Blueprints</span>
      </div>

      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black text-slate-950 tracking-tight leading-[1.08] max-w-5xl mx-auto mb-6">
        Autonomous AI, Cloud Systems &amp; <span class="text-transparent bg-clip-text bg-gradient-to-r from-sky-600 via-indigo-600 to-sky-700">Developer Velocity</span>
      </h1>

      <p class="text-lg sm:text-xl text-slate-600 max-w-2xl mx-auto mb-10 leading-relaxed font-normal">
        We rigorously stress-test developer tools, AI coding agents, and cloud platforms across thousands of production lines. Zero fluff. Pure data.
      </p>

      <!-- Trust Badges Ticker -->
      <div class="flex flex-wrap items-center justify-center gap-6 text-xs text-slate-500 font-semibold mb-8">
        <span class="flex items-center gap-1.5 text-slate-700">
          <svg class="w-4 h-4 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
          </svg>
          100% Independent Benchmarks
        </span>
        <span class="text-slate-300">•</span>
        <span class="flex items-center gap-1.5 text-slate-700">
          <svg class="w-4 h-4 text-sky-600" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
          </svg>
          Zero Paid Ranking Bias
        </span>
        <span class="text-slate-300">•</span>
        <span class="flex items-center gap-1.5 text-slate-700">
          <svg class="w-4 h-4 text-amber-500" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
          </svg>
          Tested on Production Workloads
        </span>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-4">
        <a
          href="/blog"
          class="px-8 py-4 rounded-2xl bg-slate-950 hover:bg-emerald-600 text-white font-black text-sm shadow-md hover:shadow-xl transition-all transform hover:-translate-y-0.5 flex items-center gap-2"
        >
          <span>Explore All Articles ({allPosts.length})</span>
          <span>→</span>
        </a>
        <a
          href="#newsletter"
          class="px-8 py-4 rounded-2xl bg-white hover:bg-slate-50 text-slate-900 font-extrabold text-sm border-2 border-slate-200 hover:border-slate-300 shadow-sm transition-all"
        >
          Join 18,500+ Engineers
        </a>
      </div>
    </section>

    <!-- Top Display Ad Unit -->
    <AdBanner slot="home-top-banner" label="Sponsored Partner" />

    <!-- Lead Editorial Feature Story -->
    {featuredPost && (
      <section class="my-14">
        <div class="flex items-center justify-between mb-6">
          <div class="flex items-center gap-2">
            <span class="text-rose-600 font-black text-lg">⚡</span>
            <h2 class="text-xl sm:text-2xl font-black text-slate-950 tracking-tight m-0">
              Lead Editorial Teardown
            </h2>
          </div>
          <span class="text-xs uppercase font-extrabold tracking-wider text-sky-700 bg-sky-50 px-2.5 py-1 rounded-full border border-sky-100">
            Benchmark of the Month
          </span>
        </div>

        <div class="bg-white border border-slate-200/90 rounded-3xl p-6 sm:p-10 shadow-sm hover:shadow-lg transition-all">
          <div class="flex flex-col lg:flex-row gap-8 items-center">
            <div class="lg:w-1/2 w-full h-64 sm:h-80 rounded-2xl overflow-hidden bg-slate-900 shadow-xs relative">
              <img
                src={featuredPost.data.heroImage}
                alt={featuredPost.data.title}
                class="w-full h-full object-cover"
              />
            </div>

            <div class="lg:w-1/2 w-full flex flex-col justify-between">
              <div>
                <div class="flex items-center gap-3 mb-4">
                  <span class="text-xs font-extrabold uppercase tracking-wider px-3 py-1 rounded-full bg-slate-950 text-white">
                    {featuredPost.data.category}
                  </span>
                  <span class="text-xs text-slate-400 font-medium">
                    ⏱ {featuredPost.data.readingTime}
                  </span>
                  {featuredPost.data.hasAffiliateLinks && (
                    <span class="text-[10px] uppercase font-bold text-amber-800 bg-amber-50 px-2 py-0.5 rounded border border-amber-200">
                      Buyer's Guide
                    </span>
                  )}
                </div>

                <h3 class="text-2xl sm:text-3xl font-black text-slate-950 mb-4 leading-tight">
                  <a href={`/blog/${featuredPost.id}`} class="hover:text-sky-600 transition-colors">
                    {featuredPost.data.title}
                  </a>
                </h3>

                <p class="text-slate-600 leading-relaxed text-sm sm:text-base mb-6">
                  {featuredPost.data.description}
                </p>
              </div>

              <div class="flex items-center justify-between pt-5 border-t border-slate-100">
                <div class="flex items-center gap-2.5 text-xs text-slate-600">
                  <div class="w-8 h-8 rounded-full bg-slate-900 text-white flex items-center justify-center font-bold text-xs">
                    D
                  </div>
                  <div>
                    <span class="font-bold text-slate-900">{featuredPost.data.author}</span>
                    <div class="text-[11px] text-slate-400">{featuredDate}</div>
                  </div>
                </div>

                <a
                  href={`/blog/${featuredPost.id}`}
                  class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-xl bg-sky-600 hover:bg-sky-700 text-white font-bold text-xs shadow-xs transition-colors"
                >
                  Read Full Teardown →
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- Magazine Articles Grid -->
    <section class="my-16">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h2 class="text-2xl font-black text-slate-950 tracking-tight">
            Latest Tested Benchmarks
          </h2>
          <p class="text-sm text-slate-500 mt-1">
            Deep-dive reviews, system architecture guides, and cost optimizations.
          </p>
        </div>

        <a href="/blog" class="text-xs font-bold uppercase tracking-wider text-sky-600 hover:text-sky-700">
          View All ({allPosts.length}) →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {recentPosts.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    </section>

    <!-- Monetization Section: Vetted Developer Tech Stack Matrix -->
    <section class="my-16 p-8 sm:p-10 bg-white border-2 border-slate-900/10 rounded-3xl shadow-lg relative overflow-hidden">
      <div class="text-center max-w-xl mx-auto mb-10">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-xs font-black uppercase tracking-wider text-emerald-800 bg-emerald-100/90 border border-emerald-300 shadow-xs mb-3">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Verified Engineering Stack 2026</span>
        </div>
        <h3 class="text-2xl sm:text-4xl font-black text-slate-950 tracking-tight mb-3">
          Recommended Production Stack
        </h3>
        <p class="text-sm sm:text-base text-slate-600 leading-relaxed font-normal">
          The exact developer tooling, cloud VPS, and databases rigorously benchmarked and used by our engineering team daily.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        <!-- Cursor AI -->
        <div class="p-6 sm:p-7 rounded-2xl border-2 border-slate-200/80 bg-gradient-to-b from-slate-50/50 to-white hover:border-slate-900/40 hover:shadow-xl transition-all flex flex-col justify-between group">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="font-black text-slate-950 text-lg">Cursor AI</span>
              <span class="text-[10px] uppercase font-black px-2.5 py-1 rounded-full bg-slate-900 text-white shadow-2xs">#1 AI IDE</span>
            </div>
            <div class="flex items-center gap-2 text-xs font-bold text-amber-500 mb-3">
              <span>★ 4.9 / 5.0</span>
              <span class="text-slate-300">•</span>
              <span class="text-emerald-700 font-extrabold">Free Pro Trial</span>
            </div>
            <p class="text-xs sm:text-sm text-slate-600 mb-6 leading-relaxed">The premier AI-native editor for multi-file codebase refactoring and autonomous Composer loops.</p>
          </div>
          <div>
            <a
              href="https://cursor.com?ref=techpulse"
              target="_blank"
              rel="sponsored nofollow noopener"
              class="w-full py-3 px-4 rounded-xl bg-slate-950 hover:bg-emerald-600 text-white font-black text-xs shadow-md transition-all text-center flex items-center justify-center gap-2 group-hover:shadow-lg"
            >
              <span>Try Cursor Free</span>
              <span>→</span>
            </a>
            <span class="block text-[11px] text-center text-slate-600 font-bold mt-2">Tested in Lab • Zero Markup</span>
          </div>
        </div>

        <!-- Hetzner Cloud -->
        <div class="p-6 sm:p-7 rounded-2xl border-2 border-emerald-500/40 bg-gradient-to-b from-emerald-50/20 via-white to-white hover:border-emerald-600 hover:shadow-xl transition-all flex flex-col justify-between group relative">
          <div class="absolute -top-3 right-6">
            <span class="text-[10px] uppercase font-black px-3 py-1 rounded-full bg-emerald-600 text-white shadow-xs">
              ★ Best Value
            </span>
          </div>
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="font-black text-slate-950 text-lg">Hetzner Cloud</span>
            </div>
            <div class="flex items-center gap-2 text-xs font-bold text-amber-500 mb-3">
              <span>★ 4.9 / 5.0</span>
              <span class="text-slate-300">•</span>
              <span class="text-emerald-700 font-extrabold">€4.50/mo (€20 Free)</span>
            </div>
            <p class="text-xs sm:text-sm text-slate-600 mb-6 leading-relaxed">Dedicated AMD EPYC &amp; Ampere ARM compute instances at 1/4th the price of AWS EC2 or Google Cloud.</p>
          </div>
          <div>
            <a
              href="https://hetzner.com?ref=techpulse"
              target="_blank"
              rel="sponsored nofollow noopener"
              class="w-full py-3 px-4 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white font-black text-xs shadow-md shadow-emerald-600/20 transition-all text-center flex items-center justify-center gap-2"
            >
              <span>Claim €20 Free Credit</span>
              <span>→</span>
            </a>
            <span class="block text-[11px] text-center text-emerald-800 font-bold mt-2">Official Hetzner Perk • Instant Code</span>
          </div>
        </div>

        <!-- Neon Serverless -->
        <div class="p-6 sm:p-7 rounded-2xl border-2 border-slate-200/80 bg-gradient-to-b from-slate-50/50 to-white hover:border-slate-900/40 hover:shadow-xl transition-all flex flex-col justify-between group">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="font-black text-slate-950 text-lg">Neon Postgres</span>
              <span class="text-[10px] uppercase font-black px-2.5 py-1 rounded-full bg-purple-700 text-white shadow-2xs">Top Database</span>
            </div>
            <div class="flex items-center gap-2 text-xs font-bold text-amber-500 mb-3">
              <span>★ 4.8 / 5.0</span>
              <span class="text-slate-300">•</span>
              <span class="text-emerald-700 font-extrabold">Generous Free Tier</span>
            </div>
            <p class="text-xs sm:text-sm text-slate-600 mb-6 leading-relaxed">Serverless Postgres with git-like instant branching for PR previews and automated migrations.</p>
          </div>
          <div>
            <a
              href="https://neon.tech?ref=techpulse"
              target="_blank"
              rel="sponsored nofollow noopener"
              class="w-full py-3 px-4 rounded-xl bg-slate-950 hover:bg-emerald-600 text-white font-black text-xs shadow-md transition-all text-center flex items-center justify-center gap-2 group-hover:shadow-lg"
            >
              <span>Deploy Free Database</span>
              <span>→</span>
            </a>
            <span class="block text-[11px] text-center text-slate-600 font-bold mt-2">Tested in Lab • No Credit Card Required</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Email Newsletter Lead Magnet -->
    <NewsletterCTA />
  </div>
</BaseLayout>
