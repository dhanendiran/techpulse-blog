---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Advertise & Partner With TechPulse | Media Kit 2026"
  description="Partner with TechPulse to reach 18,500+ software engineers, cloud architects, and technical decision makers through independent benchmarks, newsletter sponsorships, and featured reviews."
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <!-- Header Hero -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-black uppercase tracking-wider text-sky-800 bg-sky-100/90 border border-sky-300 shadow-xs mb-4">
        <span>📢</span> Media Kit &amp; Partnerships 2026
      </div>

      <h1 class="text-4xl sm:text-6xl font-black text-slate-950 tracking-tight leading-tight mb-4">
        Reach 18,500+ Verified <span class="text-transparent bg-clip-text bg-gradient-to-r from-sky-600 via-indigo-600 to-sky-700">Software Engineers</span>
      </h1>

      <p class="text-base sm:text-xl text-slate-600 leading-relaxed font-normal max-w-2xl mx-auto">
        TechPulse is the independent benchmark destination for engineering leaders, cloud founders, and senior developers looking for high-ROI tooling.
      </p>
    </div>

    <!-- Audience Demographics Metric Cards -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 mb-16">
      <div class="p-6 rounded-3xl bg-white border-2 border-slate-900/10 shadow-md text-center">
        <div class="text-3xl sm:text-4xl font-black text-slate-950 mb-1">18,500+</div>
        <div class="text-xs font-bold uppercase tracking-wider text-slate-500">Newsletter Subscribers</div>
        <div class="text-[11px] text-emerald-600 font-bold mt-1">48.2% Avg Open Rate</div>
      </div>

      <div class="p-6 rounded-3xl bg-white border-2 border-slate-900/10 shadow-md text-center">
        <div class="text-3xl sm:text-4xl font-black text-slate-950 mb-1">72%</div>
        <div class="text-xs font-bold uppercase tracking-wider text-slate-500">Senior &amp; Staff Engineers</div>
        <div class="text-[11px] text-sky-600 font-bold mt-1">Direct Buying Authority</div>
      </div>

      <div class="p-6 rounded-3xl bg-white border-2 border-slate-900/10 shadow-md text-center">
        <div class="text-3xl sm:text-4xl font-black text-slate-950 mb-1">85,000+</div>
        <div class="text-xs font-bold uppercase tracking-wider text-slate-500">Monthly Pageviews</div>
        <div class="text-[11px] text-emerald-600 font-bold mt-1">High-Intent Organic SEO</div>
      </div>

      <div class="p-6 rounded-3xl bg-white border-2 border-slate-900/10 shadow-md text-center">
        <div class="text-3xl sm:text-4xl font-black text-slate-950 mb-1">US &amp; EU</div>
        <div class="text-xs font-bold uppercase tracking-wider text-slate-500">Primary Geography</div>
        <div class="text-[11px] text-slate-500 font-bold mt-1">Top Tier 1 Tech Hubs</div>
      </div>
    </div>

    <!-- Sponsorship Packages -->
    <div class="mb-16">
      <div class="text-center max-w-xl mx-auto mb-10">
        <h2 class="text-3xl font-black text-slate-950 tracking-tight mb-2">
          Partnership Tiers &amp; Inventory
        </h2>
        <p class="text-sm text-slate-600">
          Transparent, high-ROI sponsorship packages designed for developer tools, cloud infrastructure, and AI platforms.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Tier 1: Newsletter Primary Sponsor -->
        <div class="bg-white rounded-3xl border-2 border-slate-200/90 p-8 shadow-md hover:shadow-xl transition-all flex flex-col justify-between">
          <div>
            <div class="text-xs font-black uppercase tracking-wider text-slate-500 mb-2">Weekly Newsletter</div>
            <h3 class="text-2xl font-black text-slate-950 mb-2">Primary Sponsor</h3>
            <div class="text-3xl font-black text-slate-900 mb-4">$500 <span class="text-xs font-medium text-slate-500">/ issue</span></div>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-6">
              Exclusive header placement, custom 120-word promotional feature, primary CTA button, and shoutout to 18,500+ verified engineers.
            </p>
            <ul class="text-xs space-y-2 text-slate-700 pl-0 list-none m-0 mb-6 font-semibold">
              <li class="flex items-center gap-2"><span class="text-emerald-600 font-black">✓</span> 100% exclusive (1 sponsor per issue)</li>
              <li class="flex items-center gap-2"><span class="text-emerald-600 font-black">✓</span> Average 800-1,400 unique clicks</li>
              <li class="flex items-center gap-2"><span class="text-emerald-600 font-black">✓</span> UTM campaign tracking reports</li>
            </ul>
          </div>
          <a
            href="/contact?subject=advertising"
            class="w-full py-3 px-4 rounded-xl bg-slate-950 hover:bg-sky-600 text-white font-black text-xs text-center shadow-xs transition-colors"
          >
            Book Newsletter Slot →
          </a>
        </div>

        <!-- Tier 2: Dedicated Lab Teardown & Benchmark -->
        <div class="bg-gradient-to-b from-slate-950 to-indigo-950 text-white rounded-3xl border-2 border-sky-400/40 p-8 shadow-xl flex flex-col justify-between relative transform md:-translate-y-2">
          <div class="absolute -top-3.5 right-6">
            <span class="text-[10px] uppercase font-black px-3.5 py-1 rounded-full bg-emerald-500 text-slate-950 shadow-md">
              Most Popular
            </span>
          </div>
          <div>
            <div class="text-xs font-black uppercase tracking-wider text-sky-400 mb-2">Editorial Deep-Dive</div>
            <h3 class="text-2xl font-black text-white mb-2">Lab Benchmark Teardown</h3>
            <div class="text-3xl font-black text-white mb-4">$1,850 <span class="text-xs font-medium text-slate-400">/ article</span></div>
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed mb-6 font-normal">
              A comprehensive 2,500+ word reproducible benchmark and architectural guide testing your product against industry standards.
            </p>
            <ul class="text-xs space-y-2 text-slate-200 pl-0 list-none m-0 mb-6 font-semibold">
              <li class="flex items-center gap-2"><span class="text-emerald-400 font-black">✓</span> Permanent do-follow editorial article</li>
              <li class="flex items-center gap-2"><span class="text-emerald-400 font-black">✓</span> Featured in weekly newsletter lead story</li>
              <li class="flex items-center gap-2"><span class="text-emerald-400 font-black">✓</span> Dedicated Affiliate &amp; Deal Box placement</li>
              <li class="flex items-center gap-2"><span class="text-emerald-400 font-black">✓</span> Reproducible code repo on GitHub</li>
            </ul>
          </div>
          <a
            href="/contact?subject=advertising"
            class="w-full py-3.5 px-4 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 text-slate-950 font-black text-xs text-center shadow-lg transition-all"
          >
            Apply for Benchmark →
          </a>
        </div>

        <!-- Tier 3: Category Spotlight Banner -->
        <div class="bg-white rounded-3xl border-2 border-slate-200/90 p-8 shadow-md hover:shadow-xl transition-all flex flex-col justify-between">
          <div>
            <div class="text-xs font-black uppercase tracking-wider text-slate-500 mb-2">Site-Wide Display</div>
            <h3 class="text-2xl font-black text-slate-950 mb-2">Category Sponsorship</h3>
            <div class="text-3xl font-black text-slate-900 mb-4">$850 <span class="text-xs font-medium text-slate-500">/ month</span></div>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-6">
              Prominent top-of-article billboard and sticky sidebar banner across all articles in your target category (AI, Cloud, or DevOps).
            </p>
            <ul class="text-xs space-y-2 text-slate-700 pl-0 list-none m-0 mb-6 font-semibold">
              <li class="flex items-center gap-2"><span class="text-emerald-600 font-black">✓</span> 100% Share of Voice on category pages</li>
              <li class="flex items-center gap-2"><span class="text-emerald-600 font-black">✓</span> Custom high-converting HTML banner</li>
              <li class="flex items-center gap-2"><span class="text-emerald-600 font-black">✓</span> 30,000+ guaranteed targeted impressions</li>
            </ul>
          </div>
          <a
            href="/contact?subject=advertising"
            class="w-full py-3 px-4 rounded-xl bg-slate-950 hover:bg-sky-600 text-white font-black text-xs text-center shadow-xs transition-colors"
          >
            Reserve Category →
          </a>
        </div>
      </div>
    </div>

    <!-- Editorial Integrity Notice -->
    <div class="my-12 p-6 rounded-2xl bg-amber-50/80 border border-amber-200/90 text-amber-950 text-xs sm:text-sm leading-relaxed">
      <strong class="font-black text-amber-900">Our Editorial Independence Policy:</strong> While TechPulse accepts sponsored teardowns and display advertising, we do not compromise testing integrity. All benchmark data, latency traces, and load figures must be 100% reproducible by our readers. If a tool exhibits flaws during lab stress-testing, they will be documented transparently.
    </div>

    <!-- Contact & Booking CTA -->
    <div class="p-8 sm:p-12 rounded-3xl bg-white border-2 border-slate-900/10 shadow-lg text-center">
      <h3 class="text-2xl sm:text-3xl font-black text-slate-950 mb-3">
        Ready to Put Your Product in Front of Senior Developers?
      </h3>
      <p class="text-sm text-slate-600 max-w-xl mx-auto mb-8 leading-relaxed">
        Send us your product URL and target launch date. Our partnerships team typically responds within 24 business hours with availability and custom package options.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a
          href="/contact?subject=advertising"
          class="px-8 py-4 rounded-xl bg-slate-950 hover:bg-emerald-600 text-white font-black text-sm shadow-md transition-all flex items-center gap-2"
        >
          <span>Submit Sponsorship Inquiry</span>
          <span>→</span>
        </a>
        <a
          href="mailto:partnerships@techpulse.dev"
          class="px-8 py-4 rounded-xl bg-white hover:bg-slate-50 text-slate-900 font-bold text-sm border-2 border-slate-300 shadow-xs transition-all"
        >
          partnerships@techpulse.dev
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
